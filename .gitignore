# ═══════════════════════════════════════════
# PredictIQ — Root .gitignore
# ═══════════════════════════════════════════

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Environment
.env
.env.*
!.env.example
!.env.test.example

# Firebase credentials (NEVER commit)
firebase-service-account.json
**/firebase-service-account.json
predictiq-*-firebase-adminsdk-*.json

# ML artifacts (keep .pkl models tracked — they're essential and <10MB)
# backend/ml/*.pkl  ← TRACKED: required for app to work
backend/ml/*.png
backend/ml/training_log_*.txt
backend/ml/artifacts/

# Node
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*.iml

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Docker
.docker/

# Code review graph
.code-review-graph/
tooling/code-review-graph/.cache/

# Antigravity
.gemini/

# AI tool configs (editor-specific, not project code)
.claude/
.cursorrules
.windsurfrules
.mcp.json
.opencode.json
AGENTS.md
CLAUDE.md
GEMINI.md

# Tooling (local dev utilities)
tooling/

# Jupyter notebooks at root (keep only in backend/ml/)
/*.ipynb


# ─────────────────────────────────────────────────────
# Explicitly track production ML artifacts and dataset
# (These are essential for the app and are < 50 MB total)
# ─────────────────────────────────────────────────────
!backend/ml/*.pkl
!backend/ml/predictiq_best_model.pkl
!backend/ml/predictiq_scaler.pkl
!backend/ml/predictiq_features.json
!backend/ml/predictiq_model_report.json
!backend/ml/training_report.json
!backend/ml/predictiq_merged_dataset.csv


# Local agent installations and generated browser reports
.agent/
.agents/
.agents-*/
.agents-disabled-*/
.tools/
.worktrees/
test-results/
playwright-report/
coverage/

# Research & raw experiment data
backend/ml/data/research/
backend/ml/experiments/

# Temporary test / audit reports
backend/*-report.json
backend/*-results.txt
backend/dependency-audit.json
frontend/*-results.txt
frontend/dependency-audit.json


