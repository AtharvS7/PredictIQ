# ═══════════════════════════════════════════════════════════════
# Predictify Backend — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# Neon PostgreSQL — connection string from Neon Dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Firebase Admin SDK — use ONE of these two options:
# Option A: Path to service account JSON file (local dev)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Option B: Raw JSON string (Codespaces / Railway / Docker)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...",...}

# CORS — Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ML Model artifact paths (relative to backend/ directory)
ML_MODEL_PATH=./ml/predictiq_best_model.pkl
ML_SCALER_PATH=./ml/predictiq_scaler.pkl
ML_FEATURES_PATH=./ml/predictiq_features.json

# Application settings
DEFAULT_HOURLY_RATE_USD=75
APP_ENV=development
APP_VERSION=3.1.0

# Storage: production replicas should use a shared durable S3-compatible bucket.
# Compose also provides a named uploads volume for a single-host installation.
STORAGE_BACKEND=local
# Set true only when LOCAL_STORAGE_PATH is mounted on durable single-host storage.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET_NAME=predictiq-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
